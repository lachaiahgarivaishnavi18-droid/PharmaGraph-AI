# Copy to .env in the repository root. Python 3.12 is recommended.
DATABASE_URL=sqlite:///runtime/pharmagraph.db
STORAGE_PATH=runtime
# Use database on hosts without a persistent disk. Requires durable PostgreSQL.
DOCUMENT_STORAGE=filesystem
ENVIRONMENT=development
# Set to render-free for fail-closed PostgreSQL/database-upload checks on Render.
DEPLOYMENT_TARGET=
# Generate a unique long random value for production; empty uses a persisted local secret.
SECRET_KEY=
JWT_SECRET=
LLM_PROVIDER=offline
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# local-hashing-v1 is a no-download lexical fallback, NOT a pretrained semantic model.
# Install backend/requirements-models.txt to use a downloaded SentenceTransformer.
EMBEDDING_MODEL=local-hashing-v1
MODEL_DOWNLOADS=false
VECTOR_STORE=sqlite
VECTOR_STORE_PATH=runtime/vectors
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
PUBMED_API_KEY=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=180
# Frontend setting: put in frontend/.env.local for separate-host deployment.
# VITE_API_BASE_URL=https://your-backend.example/api/v1
# VITE_API_URL is still supported for existing configurations.
# VITE_BACKEND_PENDING=false (only after the deployed backend is healthy)
